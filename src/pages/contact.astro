---
import BaseLayout from '../layouts/BaseLayout.astro';
import InquiryForm from '../components/InquiryForm.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  url: 'https://punitdhub.github.io/business-portfolio/contact',
  name: 'Contact Fortium Group',
};
---
<BaseLayout
  title="Contact Fortium Group"
  description="Talk to Fortium Group about your next Cyber or AI Security hire — or about your own career trajectory. We read every message personally."
  path="/contact"
  jsonLd={jsonLd}
>
  <!-- §1 HERO -->
  <section class="hero" style="min-height:auto; padding-top:6rem; padding-bottom:3rem">
    <div class="particle-field" aria-hidden="true"></div>
    <div class="container hero-inner">
      <p class="eyebrow" data-reveal>Contact</p>
      <h1 data-reveal data-delay="1">Let's talk talent.</h1>
      <p class="hero-sub" data-reveal data-delay="2">
        Whether you're hiring or you're hireable, we read every message personally. Initial reply within one business day.
      </p>
    </div>
  </section>

  <!-- §2 SPLIT: FORM + CHANNELS -->
  <section style="padding-top:1rem">
    <div class="container">
      <div class="split">
        <div class="card" data-reveal style="padding:2rem">
          <h2 style="margin-top:0; font-size:1.5rem">Send a message</h2>
          <InquiryForm audience="general" />
        </div>
        <div data-reveal data-delay="1">
          <p class="eyebrow">Direct channels</p>
          <h2 style="font-size:1.5rem">Other ways to reach us.</h2>
          <ul style="list-style:none; padding:0; display:grid; gap:1rem; margin-top:1.5rem">
            <li class="card" style="padding:1.25rem">
              <p class="muted text-mono" style="font-size:0.75rem; letter-spacing:0.15em; text-transform:uppercase; margin:0">Email</p>
              <p style="margin:0.25rem 0 0; font-size:1.05rem"><a href="mailto:hello@fortiumgroup.com">hello@fortiumgroup.com</a></p>
            </li>
            <li class="card" style="padding:1.25rem">
              <p class="muted text-mono" style="font-size:0.75rem; letter-spacing:0.15em; text-transform:uppercase; margin:0">LinkedIn</p>
              <p style="margin:0.25rem 0 0; font-size:1.05rem"><a href="#" rel="noopener">linkedin.com/company/fortium-group</a></p>
              <p class="muted" style="font-size:0.8rem; margin:0.25rem 0 0">[ placeholder — update with real URL ]</p>
            </li>
            <li class="card" style="padding:1.25rem; opacity:0.7">
              <p class="muted text-mono" style="font-size:0.75rem; letter-spacing:0.15em; text-transform:uppercase; margin:0">Calendar booking</p>
              <p style="margin:0.25rem 0 0; font-size:1.05rem">
                Direct booking <span class="muted">(coming soon)</span>
              </p>
              <p class="muted" style="font-size:0.8rem; margin:0.25rem 0 0">Use the form for now — Punit responds personally.</p>
            </li>
          </ul>

          <hr class="divider" style="margin:2rem 0" />

          <div>
            <p class="eyebrow">Response time</p>
            <p>
              <strong>Initial reply within 1 business day.</strong> All inquiries are reviewed by the founder personally — no bot triage, no autoresponders.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
