---
import BaseLayout from '../layouts/BaseLayout.astro';
import InquiryForm from '../components/InquiryForm.astro';
import GlitchText from '../components/GlitchText.astro';
import DecryptText from '../components/DecryptText.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { mandates } from '../data/mandates';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const promises = [
  { icon: '◉', t: 'Confidential by default', d: 'Your details never leave our vault without your written consent. We do not blast resumes to job boards.' },
  { icon: '◎', t: 'Curated, not blasted', d: 'We pitch you to 1–2 mandates that fit your trajectory. Never a mass submission. Never a numbers game.' },
  { icon: '◈', t: 'Career-first conversations', d: 'We ask where you want to be in 3 years before we mention compensation. Your career is not a transaction.' },
];

const journey = [
  { n: '01', t: 'You submit', d: 'Drop your resume or LinkedIn through our encrypted intake. Five minutes, no account required.' },
  { n: '02', t: 'We listen', d: 'A 30-minute discovery call. We learn your trajectory, comp expectations, dealbreakers, and dream team profile.' },
  { n: '03', t: 'We curate', d: "When a mandate fits, we'll pitch you with full context — company, comp, team, why we think it's right. You decide if we proceed." },
  { n: '04', t: 'We advocate', d: "Through interviews and offer negotiations, we're in your corner. Not the company's. Our reputation is built on your career outcomes." },
];

const sevTone: Record<string, 'green' | 'amber' | 'accent'> = { OPEN: 'green', INTERVIEWING: 'amber', CLOSING: 'accent' };
---
<BaseLayout
  title="For Candidates — Confidential Cyber & AI Security Recruiting"
  description="Confidential introductions to elite Cyber and AI Security mandates. Fortium Group represents practitioners — not the company. Curated, never blasted."
  path="/candidates"
  keywords={['cyber security jobs','AI security jobs','LLM security engineer roles','AI red team careers','CISO opportunities','confidential security recruiter']}
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'For Candidates', path: '/candidates' }]}
>
  <section class="hero hero-compact">
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="container hero-inner">
      <p class="eyebrow" data-reveal>For candidates</p>
      <h1 data-reveal data-delay="1">
        Your next role should <GlitchText as="span" text="find you." auto className="accent" />
      </h1>
      <p class="hero-sub" data-reveal data-delay="2">
        Confidential introductions to Cyber & AI Security mandates that match your trajectory — not your job title. Built for practitioners who are not on the open market.
      </p>
      <div class="hero-cta" data-reveal data-delay="3">
        <a class="btn btn-primary" href="#submit">Submit Confidentially <span class="btn-arrow">→</span></a>
        <a class="btn btn-ghost" href="#mandates">Browse Open Mandates ↓</a>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <p class="eyebrow" data-reveal>Our promise</p>
      <h2 data-reveal data-delay="1"><DecryptText as="span" text="Three things you can count on." /></h2>
      <div class="grid grid-3" style="margin-top:2.5rem">
        {promises.map((p, i) => (
          <article class="panel" data-reveal data-delay={(i % 3) + 1}>
            <span class="text-accent" style="font-size:1.5rem">{p.icon}</span>
            <h3 style="margin-top:0.75rem">{p.t}</h3>
            <p>{p.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="mandates">
    <div class="container">
      <p class="eyebrow" data-reveal>Currently open</p>
      <h2 data-reveal data-delay="1">Anonymized active mandates.</h2>
      <p class="lead" data-reveal data-delay="2">
        Snapshots of roles we're filling right now. Company identities revealed under NDA after our first conversation.
      </p>
      <div class="grid grid-3" style="margin-top:2rem">
        {mandates.map((m, i) => (
          <article class="mandate" data-reveal data-delay={(i % 3) + 1}>
            <div class="mandate-head">
              <span>{m.ref}</span>
              <StatusBadge label={m.status} tone={sevTone[m.status]} />
            </div>
            <h3 class="mandate-title">{m.title}</h3>
            <p class="mandate-meta" style="margin:0">{m.company}</p>
            <p class="mandate-meta" style="margin:0">{m.location}</p>
            <p class="mandate-comp" style="margin-top:0.5rem">{m.comp}</p>
          </article>
        ))}
      </div>
      <p class="dim text-mono" style="font-size:0.7rem; margin-top:1.5rem; text-align:center; letter-spacing:0.15em">
        // MANDATES ABOVE ARE ILLUSTRATIVE PLACEHOLDERS · EDIT src/data/mandates.ts
      </p>
    </div>
  </section>

  <section id="submit">
    <div class="container">
      <div class="split">
        <div data-reveal>
          <p class="eyebrow">Encrypted intake</p>
          <h2>Submit your profile.</h2>
          <p class="lead">
            Five fields. Five minutes. No account required. We'll read it personally.
          </p>
          <ul style="list-style:none; padding:0; margin-top:1.5rem">
            <li class="text-mono" style="font-size:0.88rem; margin-bottom:0.5rem"><span style="color:var(--accent-2)">▸</span> Confidential by default</li>
            <li class="text-mono" style="font-size:0.88rem; margin-bottom:0.5rem"><span style="color:var(--accent-2)">▸</span> Never shared without written consent</li>
            <li class="text-mono" style="font-size:0.88rem"><span style="color:var(--accent-2)">▸</span> First reply within 1 business day</li>
          </ul>
        </div>
        <div class="panel panel-accent" data-reveal data-delay="1">
          <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:1rem; padding-bottom:0.75rem; border-bottom:1px solid var(--border)">
            <span style="width:8px; height:8px; border-radius:999px; background:var(--accent-2); box-shadow:0 0 8px var(--accent-2); animation: dot-pulse 2s infinite"></span>
            <span class="text-mono" style="font-size:0.72rem; letter-spacing:0.18em; color:var(--text-muted)">READY · TLS 1.3 IN TRANSIT</span>
          </div>
          <InquiryForm audience="candidate" />
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <p class="eyebrow" data-reveal>What happens next</p>
      <h2 data-reveal data-delay="1">From submission to offer letter.</h2>
      <div class="timeline" style="margin-top:2.5rem">
        {journey.map((j, i) => (
          <div class="timeline-step" data-reveal data-delay={(i % 4) + 1}>
            <span class="step-num">STEP {j.n}</span>
            <h4>{j.t}</h4>
            <p>{j.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="container" style="text-align:center">
      <div data-reveal>
        <h2>None of the current mandates match?</h2>
        <p class="lead" style="margin-inline:auto">
          Tell us what does. New mandates open monthly — being on our radar means you hear about them first.
        </p>
        <div class="hero-cta" style="justify-content:center; margin-top:1.5rem">
          <a class="btn btn-primary" href="#submit">Get on our radar <span class="btn-arrow">→</span></a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
