---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { render } from 'astro:content';
import { getAllInsights, readingTime, formatDate, kindSection, type Insight } from '../../data/insights';
import { site } from '../../config';

export async function getStaticPaths() {
  const posts = await getAllInsights();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Insight };
const { Content } = await render(post);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = `/insights/${post.id}`;
const { title, description, pubDate, updatedDate, author, tags, kind, confirmed, sources, draft, glance } = post.data;
const isBrief = kind === 'threat-brief';
const isNews = kind !== 'guide';
const asOf = formatDate(updatedDate ?? pubDate);
const section = kindSection[kind];

// News-style Threat Brief layout: kicker + topic tags, dateline, larger lede, "At a glance" box.
// The kicker already says "Threat brief", so a leading "Threat Brief:" is dropped from the on-page headline
// (the page <title>, metadata and listings keep the full title).
const briefHeadline = isBrief ? title.replace(/^threat brief:\s*/i, '') : title;
const briefTopics = tags.filter((t) => !/^threat briefs?$/i.test(t)).slice(0, 3);
const isoDate = pubDate.toISOString().slice(0, 10);

// "Keep reading": same kind first, then anything else.
const others = (await getAllInsights()).filter((p) => p.id !== post.id);
const more = [...others.filter((p) => p.data.kind === kind), ...others.filter((p) => p.data.kind !== kind)].slice(0, 2);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@type': 'Person', name: author, url: `${site.url}/about/` },
  publisher: { '@type': 'Organization', '@id': `${site.url}/#org`, name: site.name, logo: { '@type': 'ImageObject', url: `${site.url}/logo.png` } },
  image: `${site.url}/og.png`,
  url: `${site.url}${path}/`,
  mainEntityOfPage: `${site.url}${path}/`,
  keywords: tags.join(', '),
};
---
<BaseLayout
  title={title}
  description={description}
  path={path}
  keywords={tags}
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Insights', path: '/insights' }, ...(isNews ? [section] : []), { name: title, path }]}
  jsonLd={jsonLd}
  article={{ publishedTime: pubDate, modifiedTime: updatedDate, tags }}
>
  <section class="hero hero-compact">
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="container hero-inner" style="max-width:820px">
      <p class="eyebrow" data-reveal>
        <a href={`${base}/insights/`}>Insights</a>{isNews && <> / <a href={`${base}${section.path}/`}>{section.name}</a></>}
      </p>
      {draft && <p class="article-notice notice-warn" role="note"><strong>Draft preview.</strong> This article has <code>draft: true</code> and is not included in the live site build.</p>}
      {isBrief ? (
        <>
          <p class="brief-kicker" data-reveal data-delay="1">
            <span class="brief-kicker-tag">Threat brief</span>
            {briefTopics.length > 0 && <span>{briefTopics.join(' · ')}</span>}
          </p>
          <h1 class="brief-title" data-reveal data-delay="1">{briefHeadline}</h1>
          <p class="brief-dateline" data-reveal data-delay="2">
            <strong>Toronto, <time datetime={pubDate.toISOString()}>{isoDate}</time></strong>
            {' · '}{site.name} Insights · By <a href={`${base}/about/`}>{author}</a>{updatedDate && ` · Updated ${updatedDate.toISOString().slice(0, 10)}`} · {readingTime(post)}
          </p>
        </>
      ) : (
        <>
          <h1 data-reveal data-delay="1" style="font-size:clamp(2rem, 3.4vw + 0.6rem, 3.1rem)">{title}</h1>
          <p class="hero-sub" data-reveal data-delay="2">{description}</p>
          <p class="dim text-mono caption" data-reveal data-delay="3">
            By <a href={`${base}/about/`}>{author}</a> · {formatDate(pubDate)}{updatedDate && ` · Updated ${formatDate(updatedDate)}`} · {readingTime(post)}
          </p>
        </>
      )}
    </div>
  </section>

  <section style="padding-top:1rem">
    <div class="container" style="max-width:820px">
      {isNews && !confirmed && (
        <aside class="article-notice notice-warn" role="note" aria-label="Unconfirmed notice">
          <p><span class="badge badge-amber">Unconfirmed</span> <strong>Not yet confirmed.</strong> The main claim in this {isBrief ? 'brief' : 'article'} has not been confirmed by the affected organization, the vendor or an authority. Treat it as reported, not established.</p>
        </aside>
      )}
      {isNews && !isBrief && (
        <aside class:list={['article-notice', isBrief && 'brief-notice']} role="note" aria-label={isBrief ? 'Threat brief notice' : 'Security news notice'}>
          <p>
            <strong>{isBrief ? 'Threat brief.' : 'Security news and analysis.'}</strong> Based on public sources as of {asOf}. Details may change as more information is published; check the sources below for the latest.
            {isBrief && ' This is general information for defenders, not advice for your environment.'}
          </p>
        </aside>
      )}

      <article class:list={['prose', isBrief && 'brief-body']}>
        {isBrief && glance.length > 0 && (
          <aside class="brief-glance" aria-labelledby="glance-h">
            <h2 id="glance-h">At a glance</h2>
            <dl>
              {glance.map((g) => (<><dt>{g.label}</dt><dd>{g.value}</dd></>))}
            </dl>
          </aside>
        )}
        <Content />
      </article>

      {isBrief && (
        <aside class:list={['article-notice', isBrief && 'brief-notice']} role="note" aria-label={isBrief ? 'Threat brief notice' : 'Security news notice'}>
          <p>
            <strong>{isBrief ? 'Threat brief.' : 'Security news and analysis.'}</strong> Based on public sources as of {asOf}. Details may change as more information is published; check the sources below for the latest.
            {isBrief && ' This is general information for defenders, not advice for your environment.'}
          </p>
        </aside>
      )}

      {sources.length > 0 && (
        <section class="article-sources" aria-labelledby="sources-h">
          <h2 id="sources-h">Sources</h2>
          <ol>
            {sources.map((src) => (
              <li><a href={src.url} rel="noopener noreferrer" target="_blank">{src.title}</a></li>
            ))}
          </ol>
          <p class="dim caption">Based on public sources as of {asOf}.</p>
        </section>
      )}

      <aside class="panel panel-accent" style="margin-top:3rem; padding:2rem">
        <p class="eyebrow">About the author</p>
        <h2 style="font-size:1.3rem; margin:0.25rem 0 0.5rem">{author}</h2>
        <p class="muted" style="margin:0 0 1.25rem">
          Written by the {site.name} team, with 15+ years in the Cyber Security industry. Fortium places Cyber and AI Security talent vetted by active practitioners.
        </p>
        <div class="hero-cta" style="margin:0">
          <a class="btn btn-primary" href={`${base}/employers/#brief`}>Brief us on a role <span class="btn-arrow">→</span></a>
          <a class="btn btn-ghost" href={`${base}/salary-benchmark/`}>Free salary benchmark</a>
        </div>
      </aside>
    </div>
  </section>

  {more.length > 0 && (
    <section class="section-tight">
      <div class="container" style="max-width:820px">
        <p class="eyebrow">Keep reading</p>
        <div class="grid grid-2" style="margin-top:1rem">
          {more.map((p) => (
            <a class="panel role-card" href={`${base}/insights/${p.id}/`}>
              <h3>{p.data.title}</h3>
              <span class="text-accent">Read article →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
