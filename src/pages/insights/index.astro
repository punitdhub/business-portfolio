---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InsightCards from '../../components/InsightCards.astro';
import InsightNav from '../../components/InsightNav.astro';
import { getAllInsights, getGuides, getSecurityNews, getThreatBriefs, readingTime, formatDate } from '../../data/insights';
import { site } from '../../config';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = await getAllInsights();
const guides = await getGuides();
const news = (await getSecurityNews()).slice(0, 3);
const briefs = (await getThreatBriefs()).slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: `${site.name} Insights`,
  url: `${site.url}/insights/`,
  blogPost: posts.map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    url: `${site.url}/insights/${p.id}/`,
    datePublished: p.data.pubDate.toISOString(),
    author: { '@type': 'Person', name: p.data.author },
  })),
};
---
<BaseLayout
  title="Insights — Cyber & AI Security Hiring"
  description="Practitioner-written hiring guides, security news analysis and threat briefs for Cyber and AI Security leaders."
  path="/insights"
  keywords={['cyber security hiring guide', 'AI security salary', 'how to hire a CISO', 'AI red team hiring', 'security recruiting insights']}
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Insights', path: '/insights' }]}
  jsonLd={jsonLd}
>
  <section class="hero hero-compact">
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="container hero-inner">
      <p class="eyebrow" data-reveal>Insights</p>
      <h1 data-reveal data-delay="1">Field notes on <span class="accent">security hiring.</span></h1>
      <p class="hero-sub" data-reveal data-delay="2">
        Salary data, hiring playbooks, and interview frameworks for Cyber and AI Security — written by practitioners, not marketers.
      </p>
      <p class="dim text-mono caption" data-reveal data-delay="3"><a href={site.linkedin} target="_blank" rel="noopener noreferrer">Follow Fortium on LinkedIn for new articles →</a></p>
    </div>
  </section>

  <section style="padding-top:1rem">
    <div class="container">
      <InsightNav current="/insights" />
      <p class="eyebrow">Hiring guides</p>
      {guides.length === 0 && (
        <p class="lead">New articles are on the way. <a href={site.linkedin} target="_blank" rel="noopener noreferrer">Follow Fortium on LinkedIn</a> to hear when they're published.</p>
      )}
      <div class="grid grid-3" style="margin-top:1rem">
        {guides.map((p, i) => (
          <a class="panel role-card" href={`${base}/insights/${p.id}/`} data-reveal data-delay={(i % 3) + 1}>
            <span class="text-mono dim caption">{formatDate(p.data.pubDate)} · {readingTime(p)}</span>
            <h2 class="role-h" style="margin:0.25rem 0 0">{p.data.title}</h2>
            <p class="muted">{p.data.description}</p>
            <span class="text-accent">Read article →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <p class="eyebrow">Security news</p>
      <h2 style="margin:0.25rem 0 0.5rem">What changed in regulation, leadership and the talent market, and what it means for security teams.</h2>
      {news.length > 0 ? (
        <div style="margin-top:1rem"><InsightCards posts={news} heading="h3" /></div>
      ) : (
        <p class="muted">The first security news articles are on the way.</p>
      )}
      <p style="margin-top:1rem"><a class="text-accent" href={`${base}/insights/security-news/`}>All security news →</a></p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <p class="eyebrow">Threat briefs</p>
      <h2 style="margin:0.25rem 0 0.5rem">Short, sourced briefs on threats security teams should check this week.</h2>
      {briefs.length > 0 ? (
        <div style="margin-top:1rem"><InsightCards posts={briefs} heading="h3" cta="Read brief →" showDescription={false} /></div>
      ) : (
        <p class="muted">The first threat briefs are on the way.</p>
      )}
      <p style="margin-top:1rem"><a class="text-accent" href={`${base}/insights/threat-briefs/`}>All threat briefs →</a></p>
    </div>
  </section>
</BaseLayout>
