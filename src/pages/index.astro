---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroOrb from '../components/HeroOrb.astro';
import TerminalHero from '../components/TerminalHero.astro';
import InquiryForm from '../components/InquiryForm.astro';
import StatCounter from '../components/StatCounter.astro';
import ScheduleButton from '../components/ScheduleButton.astro';
import GlitchText from '../components/GlitchText.astro';
import DecryptText from '../components/DecryptText.astro';
import StatusBadge from '../components/StatusBadge.astro';
import Icon from '../components/Icon.astro';
import { stats } from '../data/stats';
import { allRoles } from '../data/roles';
import { glossary } from '../data/faqs';
import { features } from '../config';

const orgLd = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'ProfessionalService'],
  name: 'Fortium Group',
  url: 'https://punitdhub.github.io/business-portfolio/',
  logo: 'https://punitdhub.github.io/business-portfolio/favicon.svg',
  image: 'https://punitdhub.github.io/business-portfolio/og.svg',
  description:
    'Direct-hire recruiting agency specializing in Cyber Security and AI Security talent placement. Founded by industry veterans with 15+ years of domain experience.',
  founder: { '@type': 'Person', name: 'Punit Dwivedi' },
  knowsAbout: [
    'Cyber Security recruiting', 'AI Security recruiting', 'CISO placement',
    'LLM security engineering', 'Zero Trust architecture', 'Cloud detection engineering',
    'AppSec engineering', 'AI Red Team recruiting', 'Adversarial ML', 'Security Operations',
  ],
  areaServed: { '@type': 'Place', name: 'Worldwide' },
  serviceType: 'Direct-Hire Recruiting',
  sameAs: ['https://www.linkedin.com/company/fortium-group/'],
};

const howToLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How Fortium Group Vets Cyber Security Candidates',
  description:
    'A five-stage protocol for sourcing, vetting, and placing Most Placeable Candidates (MPCs) in Cyber and AI Security roles.',
  totalTime: 'P7D',
  step: [
    { '@type': 'HowToStep', position: 1, name: 'Intake calibration', text: 'Working session with the hiring manager to map technical depth, leadership signal, threat model, comp band, and dealbreakers.' },
    { '@type': 'HowToStep', position: 2, name: 'Practitioner sourcing', text: 'Surface candidates through our network of 1,200+ active security operators — most are not on the open market.' },
    { '@type': 'HowToStep', position: 3, name: 'Expert technical screen', text: 'Active CISO or principal engineer validates the candidate against your specific threat surface.' },
    { '@type': 'HowToStep', position: 4, name: 'Cultural and compensation calibration', text: 'Pre-negotiate expectations on package, location, equity, and team fit before final-round interviews.' },
    { '@type': 'HowToStep', position: 5, name: 'Reference verification', text: 'Backchannel checks with prior security peers — the kind only practitioners can credibly run.' },
  ],
};

const definedTermLd = glossary.map((g, i) => ({
  '@context': 'https://schema.org',
  '@type': 'DefinedTerm',
  '@id': `#term-${i}`,
  name: g.term,
  description: g.definition,
  inDefinedTermSet: 'Fortium Cyber & AI Security Glossary',
}));

const bento = [
  { wide: true,  title: '15+ Years In The Trenches',     body: 'Built by practitioners who shipped SOCs, ran red teams, and architected Zero Trust — not generalist recruiters.', icon: 'shield' as const },
  { wide: false, title: 'Expert-Validated Talent',       body: 'Every shortlist is screened by an active CISO or principal security engineer before it touches your inbox.',     icon: 'shield-check' as const },
  { wide: false, title: 'Tactical Speed',                body: 'First qualified slate in 7 days. Average time-to-offer: 21 days — vs an industry median of 68 days.',           icon: 'bolt' as const },
  { wide: true,  title: 'Built For Modern Threats',     body: 'We recruit LLM Security Engineers, AI Red Teamers, Cloud Detection Engineers, AppSec Architects, and Zero Trust leads.', icon: 'layers' as const },
  { wide: false, title: 'Direct-Hire, Not Drip-Feed',    body: 'Permanent placement only. We commit to fit, not headcount throughput.',                                           icon: 'target' as const },
];

const process = [
  { n: '01', t: 'Intake calibration',       d: 'We sit with your hiring manager to map technical depth, leadership signal, and team culture before sourcing.' },
  { n: '02', t: 'Practitioner sourcing',    d: 'Our network of active security operators surfaces candidates invisible to generalist recruiters.' },
  { n: '03', t: 'Expert technical screen',  d: 'Active CISOs and principal engineers validate skills against the actual threat surface you operate in.' },
  { n: '04', t: 'Shortlist delivered',      d: '3–5 Most Placeable Candidates land in your inbox, typically within 7 business days.' },
];
---
<BaseLayout
  title="Fortium Group — Cyber & AI Security Recruiting"
  description="Direct-hire recruiting for Cyber Security and AI Security talent. Founded by industry veterans with 15+ years of domain experience. Gems, not just resumes."
  path="/"
  keywords={['cyber security recruiting','AI security recruiting','CISO recruiter','LLM security hiring','AI red team recruiter','direct hire cyber','Zero Trust hiring']}
  breadcrumbs={[{ name: 'Home', path: '/' }]}
  jsonLd={[orgLd, howToLd, ...definedTermLd]}
>
  <!-- §1 HERO -->
  <section class="hero">
    <div class="mesh-bg" aria-hidden="true"></div>
    <div class="grid-bg" aria-hidden="true"></div>
    <HeroOrb />
    <div class="container hero-inner">
      <div class="hero-badges" data-reveal>
        <StatusBadge label="OPERATIONAL" tone="green" />
        <StatusBadge label="VETTING LIVE" tone="accent" />
        <StatusBadge label="2026 INTAKE OPEN" tone="amber" />
      </div>
      <p class="eyebrow" data-reveal>Cyber & AI Security Recruiting</p>
      <h1 data-reveal data-delay="1">
        Securing your infrastructure begins with <GlitchText as="span" text="securing your talent." auto className="accent" />
      </h1>
      <p class="hero-sub" data-reveal data-delay="2">
        Fortium Group delivers deeply vetted Cyber & AI Security leaders — placed faster, validated by practitioners, ready on day one. <span class="gradient-text" style="font-weight:600">Gems, not just resumes.</span>
      </p>
      <div class="hero-cta" data-reveal data-delay="3">
        <ScheduleButton label="Start Hiring" />
        <a class="btn btn-ghost" href="#network">See how we vet ↓</a>
      </div>
    </div>
  </section>

  <!-- §2 VETTING NETWORK — text-led, no decorative graph -->
  <section id="network" style="padding-top:3.5rem">
    <div class="container" style="max-width: 920px">
      <p class="eyebrow" data-reveal>The vetting network</p>
      <h2 data-reveal data-delay="1">Practitioners vetting practitioners.</h2>
      <p class="lead" data-reveal data-delay="2">
        Every Fortium placement passes through a network of active CISOs, red team leads, and principal engineers. No generalist recruiters in the loop. No résumé theater. Real signal, validated by people who ship in production.
      </p>
      <div class="pill-cloud" style="margin-top:1.75rem" data-reveal data-delay="3">
        <span class="pill"><span class="dot"></span>1,200+ operators</span>
        <span class="pill"><span class="dot"></span>4 continents</span>
        <span class="pill"><span class="dot"></span>Active vetters only</span>
        <span class="pill"><span class="dot"></span>CISO · North America</span>
        <span class="pill"><span class="dot"></span>Red Team · Europe</span>
        <span class="pill"><span class="dot"></span>AI · San Francisco</span>
        <span class="pill"><span class="dot"></span>Cloud · Singapore</span>
      </div>
    </div>
  </section>

  <!-- §3 LOGO RAIL -->
  <section class="section-tight">
    <div class="container">
      <p class="eyebrow" data-reveal style="justify-content:center; display:flex">Trusted by security teams at</p>
      <div class="logo-rail" data-reveal data-delay="1" aria-label="Placeholder client roster">
        <span class="client">CLIENT.01</span>
        <span class="client">CLIENT.02</span>
        <span class="client">CLIENT.03</span>
        <span class="client">CLIENT.04</span>
        <span class="client">CLIENT.05</span>
      </div>
    </div>
  </section>

  <!-- §4 USP BENTO -->
  <section id="bento">
    <div class="container">
      <p class="eyebrow" data-reveal>Why Fortium</p>
      <h2 data-reveal data-delay="1"><DecryptText as="span" text="A vetting protocol built by security people, for security people." /></h2>
      <div class="bento" style="margin-top:2.5rem">
        {bento.map((t, i) => (
          <article class={`panel bento-tile ${t.wide ? 'tile-wide' : 'tile-square'}`} data-reveal data-delay={(i % 4) + 1}>
            <span class="bento-icon"><Icon name={t.icon} size={26} strokeWidth={1.5} /></span>
            <h3>{t.title}</h3>
            <p>{t.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- §5 ANSWER BLOCK (AEO + Speakable) -->
  <section class="section-tight">
    <div class="container">
      <article class="answer-block" data-reveal>
        <h2>What is a "Most Placeable Candidate"?</h2>
        <p>
          A <strong>Most Placeable Candidate (MPC)</strong> is a pre-vetted Cyber Security or AI Security professional whose technical depth, leadership signal, compensation expectations, and cultural fit have been independently validated by an active industry practitioner. Fortium Group's MPC framework reduces hiring-manager interview load by an average of 60% and produces offer-to-acceptance rates above 90%.
        </p>
      </article>
    </div>
  </section>

  <!-- §6 ROLES -->
  <section id="roles">
    <div class="container">
      <p class="eyebrow" data-reveal>Practice areas</p>
      <h2 data-reveal data-delay="1">Roles we place.</h2>
      <p class="lead" data-reveal data-delay="2">
        From first-CISO mandates at Series-B startups to AI Red Team builds at Fortune 500 enterprises — Fortium covers the full Cyber and AI Security stack.
      </p>
      <div class="pill-cloud" style="margin-top:2rem" data-reveal data-delay="3">
        {allRoles.map((r) => (
          <span class="pill"><span class="dot"></span>{r}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- §7 PROCESS TIMELINE -->
  <section>
    <div class="container">
      <p class="eyebrow" data-reveal>The vetting protocol</p>
      <h2 data-reveal data-delay="1">From brief to shortlist in 7 days.</h2>
      <div class="timeline" style="margin-top:2.5rem">
        {process.map((p, i) => (
          <div class="timeline-step" data-reveal data-delay={(i % 4) + 1}>
            <span class="step-num">STEP {p.n}</span>
            <h4>{p.t}</h4>
            <p>{p.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- §8 STAT BAND -->
  <section class="section-tight">
    <div class="container">
      <div class="stat-band" data-reveal>
        {stats.map((s) => <StatCounter value={s.value} label={s.label} />)}
      </div>
      <p class="dim text-mono caption" style="margin-top:0.9rem; text-align:center">
        Network size and placement metrics shown as anonymized internal aggregates.
      </p>
    </div>
  </section>

  <!-- §9 TERMINAL (collapsible easter egg, no longer dominant) -->
  {features.terminalSection && (
    <section class="section-tight">
      <div class="container" style="max-width: 900px">
        <details class="shell-collapse">
          <summary>
            <span><span class="text-accent-2">$</span> open shell — explore Fortium via terminal commands</span>
          </summary>
          <div class="shell-inner">
            <p class="muted" style="font-size:0.92rem; margin: 0.5rem 0 1.25rem">
              For the curious: type <code class="text-mono text-accent">help</code> to see what's available. Try <code class="text-mono text-accent">whoami</code>, <code class="text-mono text-accent">mission</code>, or <code class="text-mono text-accent">book</code>.
            </p>
            <TerminalHero />
          </div>
        </details>
      </div>
    </section>
  )}

  <!-- §10 FINAL CTA -->
  <section>
    <div class="container">
      <div class="split">
        <div data-reveal>
          <p class="eyebrow">Start the conversation</p>
          <h2>Tell us who you need. We'll bring the gem.</h2>
          <p class="lead">
            Brief us on the role, the team, and the urgency. You'll have a qualified shortlist faster than your next sprint review.
          </p>
          <p class="muted text-mono" style="font-size:0.85rem">
            — Punit Dwivedi, <span class="gradient-text" style="font-weight:600">Founder</span>
          </p>
        </div>
        <div class="panel panel-accent" data-reveal data-delay="1">
          <InquiryForm audience="client" />
        </div>
      </div>
    </div>
  </section>

  <!-- Hidden glossary — semantic gold for GEO, no aesthetic impact -->
  <section class="sr-only" aria-hidden="true">
    <h2>Glossary</h2>
    <dl>
      {glossary.map((g) => (
        <>
          <dt>{g.term}</dt>
          <dd>{g.definition}</dd>
        </>
      ))}
    </dl>
  </section>
</BaseLayout>
