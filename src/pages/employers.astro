---
import BaseLayout from '../layouts/BaseLayout.astro';
import InquiryForm from '../components/InquiryForm.astro';
import ScheduleButton from '../components/ScheduleButton.astro';
import GlitchText from '../components/GlitchText.astro';
import DecryptText from '../components/DecryptText.astro';
import { faqs } from '../data/faqs';
import { comparisonRows } from '../data/stats';
import { cyberRoles, aiSecurityRoles } from '../data/roles';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const vetting = [
  { n: '01', t: 'Intake calibration', d: 'A working session with your hiring manager to map technical depth, leadership signal, threat model, comp band, and dealbreakers.' },
  { n: '02', t: 'Practitioner sourcing', d: 'We surface candidates through our network of 1,200+ active security operators — most are not on the open market.' },
  { n: '03', t: 'Expert technical screen', d: 'An active CISO or principal engineer validates the candidate against your specific threat surface — not a generic skills checklist.' },
  { n: '04', t: 'Cultural & comp calibration', d: 'We pre-negotiate expectations on package, location, equity, and team fit before you ever meet them.' },
  { n: '05', t: 'Reference verification', d: 'Backchannel checks with prior security peers — the kind that only practitioners can credibly run.' },
];

const models = [
  { name: 'Direct-Hire (Contingency)', best: 'Single role, moderate urgency', fee: 'Pay only on placement', bullets: ['No upfront cost', '90-day replacement guarantee', 'Typical engagement: 1–6 weeks'], badge: 'Most popular' },
  { name: 'Retained Search', best: 'Senior leadership (CISO / VP)', fee: 'Engaged fee, exclusive partnership', bullets: ['Confidential incumbent replacement', 'Board-level reporting', 'Dedicated practitioner panel'], badge: 'Executive' },
  { name: 'Embedded Recruiter', best: 'Multi-hire team builds', fee: 'Monthly retainer + per-hire', bullets: ['Sits inside your TA function', 'Builds full security pipeline', 'Best for 5+ hires in 6 months'], badge: 'Scale-up' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Cyber Security Recruiting',
    provider: { '@type': 'Organization', name: 'Fortium Group' },
    areaServed: 'Worldwide',
    description: 'Direct-hire recruiting for Cyber and AI Security roles including CISO, VP of Security, AI Red Team, Cloud Security, AppSec, and Zero Trust architecture.',
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Engagement Models',
      itemListElement: models.map((m) => ({
        '@type': 'Offer', name: m.name, description: `${m.best}. Fee: ${m.fee}.`,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<BaseLayout
  title="For Employers — Cyber & AI Security Recruiting"
  description="How Fortium Group vets Cyber and AI Security candidates: 5-stage protocol, 7-day shortlists, 90-day replacement guarantee. Direct-hire, retained, and embedded models."
  path="/employers"
  keywords={['CISO recruiter','cyber security recruiting firm','AI security recruiter','vetting protocol','direct hire security','retained search CISO']}
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'For Employers', path: '/employers' }]}
  jsonLd={jsonLd}
>
  <section class="hero" style="min-height:auto; padding-top:6rem; padding-bottom:4rem">
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="container hero-inner">
      <p class="eyebrow" data-reveal>For employers</p>
      <h1 data-reveal data-delay="1">
        Stop reviewing resumes. <GlitchText as="span" text="Start hiring gems." auto className="accent" />
      </h1>
      <p class="hero-sub" data-reveal data-delay="2">
        Direct-hire Cyber & AI Security recruiting, engineered for hiring managers who refuse to settle. 5-stage vetting. 7-day shortlists. 90-day replacement guarantee.
      </p>
      <div class="hero-cta" data-reveal data-delay="3">
        <ScheduleButton label="Brief Us On Your Role" />
        <a class="btn btn-ghost" href="#vetting">See Vetting Protocol ↓</a>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <article class="answer-block" data-reveal>
        <h2>How does Fortium Group vet Cyber Security candidates?</h2>
        <p>
          Fortium Group uses a <strong>5-stage vetting protocol</strong>: (1) intake calibration with the hiring manager, (2) sourcing through our practitioner network, (3) technical screen by an active CISO or principal engineer, (4) cultural and compensation calibration, (5) reference verification with prior security peers. The result is a shortlist of 3–5 Most Placeable Candidates ready for final-round interviews, typically within 7 business days.
        </p>
      </article>
    </div>
  </section>

  <section id="vetting">
    <div class="container">
      <p class="eyebrow" data-reveal>The protocol</p>
      <h2 data-reveal data-delay="1"><DecryptText as="span" text="A five-stage funnel built by practitioners." /></h2>
      <div class="grid grid-3" style="margin-top:2.5rem">
        {vetting.map((v, i) => (
          <article class="panel" data-reveal data-delay={(i % 4) + 1}>
            <span class="text-mono text-accent" style="font-size:0.78rem; letter-spacing:0.18em">STAGE {v.n}</span>
            <h3 style="margin-top:0.5rem">{v.t}</h3>
            <p>{v.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <p class="eyebrow" data-reveal>Engagement models</p>
      <h2 data-reveal data-delay="1">Three ways to work with Fortium.</h2>
      <div class="grid grid-3" style="margin-top:2.5rem">
        {models.map((m, i) => (
          <article class="panel" data-reveal data-delay={(i % 3) + 1} style="display:flex; flex-direction:column; gap:0.75rem">
            <span class="pill" style="align-self:flex-start"><span class="dot"></span>{m.badge}</span>
            <h3 style="margin:0">{m.name}</h3>
            <p class="muted" style="margin:0; font-size:0.9rem"><strong style="color:var(--text)">Best for:</strong> {m.best}</p>
            <p class="muted" style="margin:0; font-size:0.9rem"><strong style="color:var(--text)">Fee:</strong> {m.fee}</p>
            <ul style="padding-left:1.1rem; margin:0.5rem 0 0; color:var(--text-muted); font-size:0.9rem">
              {m.bullets.map((b) => <li style="margin-bottom:0.3rem">{b}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="split">
        <div data-reveal>
          <p class="eyebrow">Speed vs. industry</p>
          <h2>We move at the speed of the threat — without skipping vetting.</h2>
          <p class="lead">
            Industry average time-to-fill for a senior security role: <strong>68 days</strong>. Fortium average: <strong>21 days</strong>. We compress the timeline by doing the vetting upstream — before you ever see a resume.
          </p>
        </div>
        <div class="panel" data-reveal data-delay="1" style="padding:2rem">
          <table style="width:100%; border-collapse:collapse; font-size:0.95rem; font-family: var(--font-mono)">
            <thead>
              <tr style="border-bottom:1px solid var(--border)">
                <th style="text-align:left; padding:0.5rem 0; font-weight:500"></th>
                <th class="text-accent" style="text-align:right; padding:0.5rem 0; font-size:0.78rem; letter-spacing:0.15em">FORTIUM</th>
                <th class="dim" style="text-align:right; padding:0.5rem 0; font-size:0.78rem; letter-spacing:0.15em">INDUSTRY</th>
              </tr>
            </thead>
            <tbody>
              {comparisonRows.map((r) => (
                <tr style="border-bottom:1px solid var(--border)">
                  <td style="padding:0.65rem 0">{r.metric}</td>
                  <td style="text-align:right" class="text-accent">{r.fortium}</td>
                  <td class="dim" style="text-align:right">{r.industry}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="dim" style="font-family:var(--font-mono); font-size:0.7rem; margin-top:1rem; margin-bottom:0; letter-spacing:0.1em">
            // INDUSTRY: SHRM 2024 BENCHMARKS · FORTIUM: INTERNAL PLACEHOLDERS, AUDIT PENDING
          </p>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <article class="answer-block" data-reveal style="border-left-color:var(--accent-2)">
        <h2>The 90-day guarantee.</h2>
        <p>
          Every direct-hire placement carries a <strong>90-day replacement guarantee</strong>. If the candidate leaves or is terminated for cause within 90 days of start, we re-run the search at no additional fee. Because we only get paid when you keep a hire, our incentives are aligned with retention — not headcount churn.
        </p>
      </article>
    </div>
  </section>

  <section id="roles">
    <div class="container">
      <p class="eyebrow" data-reveal>Practice areas (full taxonomy)</p>
      <h2 data-reveal data-delay="1">Roles we recruit.</h2>
      <div class="grid grid-2" style="margin-top:2rem">
        <article class="panel" data-reveal>
          <h3>Cyber Security</h3>
          <ul style="padding-left:1.1rem; color:var(--text-muted); margin:0; columns:2; column-gap:1.5rem; font-size:0.92rem">
            {cyberRoles.map((r) => <li style="margin-bottom:0.2rem">{r}</li>)}
          </ul>
        </article>
        <article class="panel" data-reveal data-delay="1">
          <h3>AI Security</h3>
          <ul style="padding-left:1.1rem; color:var(--text-muted); margin:0; columns:2; column-gap:1.5rem; font-size:0.92rem">
            {aiSecurityRoles.map((r) => <li style="margin-bottom:0.2rem">{r}</li>)}
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <p class="eyebrow" data-reveal>FAQ</p>
      <h2 data-reveal data-delay="1">Questions hiring managers ask us.</h2>
      <div style="margin-top:2rem; max-width:75ch">
        {faqs.map((f, i) => (
          <details class="faq-item" data-reveal data-delay={(i % 4) + 1}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section id="brief">
    <div class="container">
      <div class="split">
        <div data-reveal>
          <p class="eyebrow">Brief us</p>
          <h2>Send a role brief. Get a shortlist.</h2>
          <p class="lead">
            Drop the role you're trying to fill, the urgency, and any context. Punit will personally read your brief and respond within one business day.
          </p>
          <p class="muted text-mono" style="font-size:0.85rem">
            <span style="color:var(--accent-2)">●</span> Initial conversation is free — no engagement fee until we mutually decide to proceed.
          </p>
        </div>
        <div class="panel panel-accent" data-reveal data-delay="1">
          <InquiryForm audience="client" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
