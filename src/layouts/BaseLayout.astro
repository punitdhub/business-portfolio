---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import ConstellationCursor from '../components/ConstellationCursor.astro';
import EasterEgg from '../components/EasterEgg.astro';
import ThreatTicker from '../components/ThreatTicker.astro';
import SEO from '../components/SEO.astro';
import { features } from '../config';

export interface Props {
  title: string;
  description: string;
  path?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  keywords?: string[];
  breadcrumbs?: { name: string; path: string }[];
  showTicker?: boolean;
}
const { title, description, path, jsonLd, keywords, breadcrumbs, showTicker = true } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="theme-color" content="#16181E" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F8F9FB" media="(prefers-color-scheme: light)" />

    <!-- Type — Inter (variable, optical-sizing capable) + JetBrains Mono for mono contexts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300..700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <SEO
      title={title}
      description={description}
      path={path}
      jsonLd={jsonLd}
      keywords={keywords}
      breadcrumbs={breadcrumbs}
    />

    <!-- Theme bootstrap: prevent flash by setting attribute before paint -->
    <script is:inline>
      (function () {
        try {
          const k = 'fortium-theme';
          const t = localStorage.getItem(k) || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
          if (t === 'dark' || t === 'light' || t === 'rootkit') document.documentElement.dataset.theme = t;
        } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="visually-hidden">Skip to main content</a>
    {showTicker && features.threatTicker && <ThreatTicker />}
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <ScrollReveal />
    {features.constellationCursor && <ConstellationCursor />}
    {features.konamiEasterEgg && <EasterEgg />}
  </body>
</html>
