---
export interface Props {
  value: string; // e.g. "15+", "94%", "21d"
  label: string;
}
const { value, label } = Astro.props;
---
<div class="stat">
  <span class="num" data-counter data-target={value} aria-hidden="true">{value}</span>
  <span class="sr-only">{value}</span>
  <span class="label">{label}</span>
</div>

<script is:inline>
  // Emitted once per StatCounter instance, so initialise only once per page.
  (function () {
    if (window.__fgStatCounter) return;
    window.__fgStatCounter = true;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (!('IntersectionObserver' in window)) return;
    const glyphs = '!@#$%&*+=<>?/\\|01ABCDEFGHJKLMNPQRSTUVWXYZ';

    function animate(el) {
      const target = el.dataset.target || el.textContent;
      const chars = target.split('');
      const duration = 1200;
      const start = performance.now();
      function frame(now) {
        const p = Math.min(1, (now - start) / duration);
        const revealCount = Math.floor(p * chars.length);
        el.textContent = chars
          .map((c, i) => (i < revealCount ? c : glyphs[Math.floor(Math.random() * glyphs.length)]))
          .join('');
        if (p < 1) requestAnimationFrame(frame);
        else el.textContent = target;
      }
      requestAnimationFrame(frame);
    }

    function init() {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { io.unobserve(e.target); animate(e.target); }
        });
      }, { threshold: 0.4 });
      document.querySelectorAll('[data-counter]').forEach((el) => io.observe(el));
    }
    // Wait for the whole page so counters rendered after this script are found.
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  })();
</script>
