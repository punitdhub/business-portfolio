---
/**
 * TerminalHero — an interactive shell prompt. Commands supported:
 *   help, whoami, mission, vetting, mandates, book, clear, sudo
 * Boots with an auto-typed sequence, then accepts user input.
 */
---
<div class="terminal" data-terminal>
  <div class="terminal-header">
    <span class="dots" aria-hidden="true"><span></span><span></span><span></span></span>
    <span>SECURE SHELL · fortium@gem · TLS 1.3</span>
  </div>
  <div class="terminal-body" data-terminal-body role="log" aria-live="polite"></div>
  <div class="terminal-input-row">
    <input
      class="terminal-input"
      type="text"
      autocomplete="off"
      spellcheck="false"
      aria-label="Terminal input"
      data-terminal-input
      placeholder="type 'help' and press enter"
    />
  </div>
</div>

<script is:inline>
  (function () {
    const term = document.querySelector('[data-terminal]');
    if (!term) return;
    const body = term.querySelector('[data-terminal-body]');
    const input = term.querySelector('[data-terminal-input]');
    const base = (document.querySelector('meta[name="base-path"]')?.getAttribute('content')) || '';

    function line(text, cls) {
      const el = document.createElement('div');
      el.className = 'terminal-line ' + (cls || '');
      el.textContent = text;
      body.appendChild(el);
      body.scrollTop = body.scrollHeight;
      return el;
    }

    function typeLine(text, cls, speed) {
      return new Promise((resolve) => {
        const el = line('', cls);
        let i = 0;
        const s = speed || 18;
        (function tick() {
          if (i <= text.length) {
            el.textContent = text.slice(0, i);
            body.scrollTop = body.scrollHeight;
            i++;
            setTimeout(tick, s + (Math.random() * 16 - 8));
          } else { resolve(); }
        })();
      });
    }

    const commands = {
      help: () => {
        line('Available commands:', 'ok');
        line('  whoami     →  identify the visitor');
        line('  mission    →  read the Fortium mission statement');
        line('  vetting    →  show the 5-stage vetting protocol');
        line('  mandates   →  list current open mandates');
        line('  book       →  navigate to the booking page');
        line('  sudo       →  attempt privilege escalation');
        line('  clear      →  clear the screen');
      },
      whoami: () => {
        const ua = navigator.userAgent;
        const platform = navigator.platform || 'unknown';
        const lang = navigator.language;
        line('Detected session:', 'ok');
        line('  browser  : ' + ua.match(/(Chrome|Firefox|Safari|Edge)\/[\d.]+/)?.[0] || 'unknown');
        line('  platform : ' + platform);
        line('  locale   : ' + lang);
        line('  threat   : low (cleared to proceed)');
      },
      mission: () => {
        line('FORTIUM GROUP — Mission', 'acc');
        line('We are practitioners-turned-recruiters. We close the gap between');
        line('elite Cyber & AI Security operators and the teams that need them.');
        line('Direct-hire only. Vetted by active experts. Gems, not just resumes.', 'ok');
      },
      vetting: () => {
        line('[01] Intake calibration       — map technical depth & threat surface', 'ok');
        line('[02] Practitioner sourcing    — surface candidates not on the market', 'ok');
        line('[03] Expert technical screen  — validated by active CISO/principal', 'ok');
        line('[04] Cultural & comp calibration', 'ok');
        line('[05] Reference verification   — backchannel via security peers', 'ok');
        line('Result: 3–5 Most Placeable Candidates in 7 business days.', 'acc');
      },
      mandates: () => {
        line('Currently active mandates:', 'acc');
        line('  FG-2026-014  Principal AI Red Teamer       — Pre-IPO FinTech    $280–340k', 'ok');
        line('  FG-2026-013  Director of Cloud Detection   — Series-C SaaS       $260k base', 'ok');
        line('  FG-2026-012  CISO (First Hire)             — Series-B Health     $300k + equity', 'ok');
        line('Type: book   to start a conversation.');
      },
      book: () => {
        line('Routing to discovery scheduler...', 'ok');
        setTimeout(() => { window.location.href = base + '/contact'; }, 800);
      },
      sudo: () => {
        line('[sudo] password for visitor: ', 'err');
        line('       ↳ access denied. Try the Konami code instead. ↑↑↓↓←→←→BA', 'err');
      },
      clear: () => { body.innerHTML = ''; },
    };

    function run(raw) {
      const cmd = raw.trim().toLowerCase().split(' ')[0];
      line(raw, 'cmd');
      if (!cmd) return;
      if (commands[cmd]) commands[cmd]();
      else { line(`fortium: command not found: ${cmd}`, 'err'); line(`Try 'help'.`, 'err'); }
    }

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const v = input.value;
        input.value = '';
        run(v);
      }
    });

    // Boot sequence — only when scrolled into view
    let booted = false;
    const io = new IntersectionObserver(async (entries) => {
      if (booted) return;
      for (const e of entries) {
        if (e.isIntersecting) {
          booted = true;
          io.disconnect();
          await typeLine('initializing secure shell...', 'ok', 20);
          await typeLine('cryptographic handshake [TLS 1.3] OK', 'ok', 12);
          await typeLine('loading practitioner network... 1,247 nodes', 'ok', 14);
          await typeLine('vetting engine: online', 'acc', 14);
          line('');
          line('Welcome. Type \"help\" to explore — or \"book\" to talk to a human.', 'acc');
          input.focus({ preventScroll: true });
        }
      }
    }, { threshold: 0.4 });
    io.observe(term);
  })();
</script>
