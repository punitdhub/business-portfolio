---
/**
 * Network Graph — minimal vetting-network diagram.
 * Single accent, slow motion, low contrast. Pure SVG + CSS.
 */
---
<svg class="netgraph" viewBox="0 0 600 400" role="img" aria-label="Vetting network diagram">
  <title>Fortium vetting network</title>
  <desc>A central node connected via vetting edges to practitioner nodes.</desc>

  <defs>
    <linearGradient id="ng-edge" x1="0" x2="1">
      <stop offset="0%"  stop-color="var(--accent)" stop-opacity="0" />
      <stop offset="50%" stop-color="var(--accent)" stop-opacity="0.45" />
      <stop offset="100%" stop-color="var(--accent)" stop-opacity="0" />
    </linearGradient>
  </defs>

  <!-- Edges (drawn first so nodes sit on top) -->
  <g stroke-linecap="round" fill="none" stroke="url(#ng-edge)" stroke-width="0.7">
    <line x1="300" y1="200" x2="100" y2="90" />
    <line x1="300" y1="200" x2="500" y2="90" />
    <line x1="300" y1="200" x2="500" y2="310" />
    <line x1="300" y1="200" x2="100" y2="310" />
    <line x1="300" y1="200" x2="70"  y2="200" />
    <line x1="300" y1="200" x2="530" y2="200" />
  </g>

  <!-- Practitioner nodes — uniform, calm -->
  <g>
    <circle cx="100" cy="90"  r="4" class="node" style="animation-delay: -0.3s" />
    <circle cx="500" cy="90"  r="4" class="node" style="animation-delay: -1.1s" />
    <circle cx="500" cy="310" r="4" class="node" style="animation-delay: -2.0s" />
    <circle cx="100" cy="310" r="4" class="node" style="animation-delay: -1.5s" />
    <circle cx="70"  cy="200" r="3.5" class="node" style="animation-delay: -0.8s" />
    <circle cx="530" cy="200" r="3.5" class="node" style="animation-delay: -1.9s" />
  </g>

  <!-- Central hub — concentric ring, slow breathing -->
  <g>
    <circle cx="300" cy="200" r="18" fill="none" stroke="var(--accent)" stroke-width="1" opacity="0.25">
      <animate attributeName="r" values="18;26;18" dur="6s" repeatCount="indefinite" />
      <animate attributeName="opacity" values="0.35;0;0.35" dur="6s" repeatCount="indefinite" />
    </circle>
    <circle cx="300" cy="200" r="8" fill="var(--accent)" opacity="0.85" />
  </g>

  <!-- Labels — sparse, mono, very low contrast -->
  <g font-family="var(--font-mono)" font-size="9" fill="var(--text-dim)" letter-spacing="1.5">
    <text x="60"  y="76"  text-anchor="start">CISO · NA</text>
    <text x="540" y="76"  text-anchor="end">RED · EU</text>
    <text x="540" y="328" text-anchor="end">AI · SF</text>
    <text x="60"  y="328" text-anchor="start">CLOUD · SG</text>
  </g>
</svg>
