---
/**
 * DecryptText — retired. Now renders plain text so existing pages keep working.
 */
export interface Props {
  text: string;
  as?: 'span' | 'h1' | 'h2' | 'h3' | 'h4' | 'p';
  duration?: number;
  className?: string;
}
const { text, as = 'span', className } = Astro.props;
const Tag = as;
---
<Tag class:list={[className]}>{text}</Tag>
