---
/**
 * Fortium Group wordmark. Minimal, confident, inspired by
 * modern SaaS brands (Linear/Vercel/Resend) — no more shield-and-gem.
 * A warm-gradient rounded square sits before the wordmark.
 */
export interface Props {
  variant?: 'lockup' | 'mark';
  height?: number;
  withLink?: boolean;
}
const { variant = 'lockup', height = 28, withLink = true } = Astro.props;
const base = import.meta.env.BASE_URL;
---

{withLink ? (
  <a href={base} aria-label="Fortium Group home" class="logo-link">
    <span class="logo" style={`--logo-h:${height}px`} data-variant={variant}>
      <svg viewBox="0 0 32 32" aria-hidden="true" class="logo-mark">
        <defs>
          <linearGradient id="logo-grad" x1="0" x2="1" y1="0" y2="1">
            <stop offset="0%" stop-color="var(--accent)" />
            <stop offset="100%" stop-color="var(--accent-2)" />
          </linearGradient>
        </defs>
        <rect x="2" y="2" width="28" height="28" rx="8" fill="url(#logo-grad)" />
        <path
          d="M11 10 L21 10 L21 13 L14 13 L14 15 L19 15 L19 18 L14 18 L14 23 L11 23 Z"
          fill="#0A0B10"
          opacity="0.95"
        />
      </svg>
      {variant === 'lockup' && (
        <span class="logo-word">Fortium<span class="logo-dot">.</span></span>
      )}
    </span>
  </a>
) : (
  <span class="logo" style={`--logo-h:${height}px`} data-variant={variant}>
    <svg viewBox="0 0 32 32" aria-hidden="true" class="logo-mark">
      <defs>
        <linearGradient id="logo-grad-2" x1="0" x2="1" y1="0" y2="1">
          <stop offset="0%" stop-color="var(--accent)" />
          <stop offset="100%" stop-color="var(--accent-2)" />
        </linearGradient>
      </defs>
      <rect x="2" y="2" width="28" height="28" rx="8" fill="url(#logo-grad-2)" />
      <path
        d="M11 10 L21 10 L21 13 L14 13 L14 15 L19 15 L19 18 L14 18 L14 23 L11 23 Z"
        fill="#0A0B10"
        opacity="0.95"
      />
    </svg>
    {variant === 'lockup' && (
      <span class="logo-word">Fortium<span class="logo-dot">.</span></span>
    )}
  </span>
)}

<style>
  .logo-link { display: inline-flex; text-decoration: none; align-items: center; }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--text);
    line-height: 1;
  }
  .logo-mark {
    width: var(--logo-h);
    height: var(--logo-h);
    display: block;
    flex-shrink: 0;
  }
  .logo-word {
    font-family: var(--font-display);
    font-weight: 620;
    font-size: calc(var(--logo-h) * 0.68);
    letter-spacing: -0.03em;
    color: var(--text);
    line-height: 1;
  }
  .logo-dot { color: var(--accent); }
</style>
