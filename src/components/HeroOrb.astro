---
// Slow-rotating cryptographic sphere.
// Each moving part is its own <svg> layer animated with `transform`/`opacity`
// only, so the browser composites it on the GPU instead of re-laying-out the
// SVG every frame. Animation pauses while the orb is off-screen.
---
<div class="hero-orb" aria-hidden="true" data-hero-orb>
  <svg class="orb-layer" viewBox="0 0 600 600">
    <defs>
      <radialGradient id="orbGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.35" />
        <stop offset="60%" stop-color="var(--accent)" stop-opacity="0.05" />
        <stop offset="100%" stop-color="var(--accent)" stop-opacity="0" />
      </radialGradient>
    </defs>
    <circle cx="300" cy="300" r="280" fill="url(#orbGlow)" />
  </svg>

  <svg class="orb-layer orb-rings" viewBox="0 0 600 600">
    <g stroke="var(--accent)" fill="none" stroke-width="1">
      <circle cx="300" cy="300" r="240" opacity="0.15" />
      <circle cx="300" cy="300" r="200" opacity="0.2" />
      <circle cx="300" cy="300" r="160" opacity="0.25" />
      <ellipse cx="300" cy="300" rx="240" ry="90" opacity="0.35" />
      <ellipse cx="300" cy="300" rx="180" ry="70" opacity="0.45" />
    </g>
  </svg>

  <svg class="orb-layer orb-wire" viewBox="0 0 600 600">
    <defs>
      <linearGradient id="orbLine" x1="0" x2="1">
        <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.0" />
        <stop offset="50%" stop-color="var(--accent)" stop-opacity="0.8" />
        <stop offset="100%" stop-color="var(--accent)" stop-opacity="0.0" />
      </linearGradient>
    </defs>
    <g stroke="url(#orbLine)" fill="none" stroke-width="1.4">
      <ellipse cx="300" cy="300" rx="220" ry="220" />
      <ellipse cx="300" cy="300" rx="220" ry="80" transform="rotate(20 300 300)" />
      <ellipse cx="300" cy="300" rx="220" ry="80" transform="rotate(60 300 300)" />
      <ellipse cx="300" cy="300" rx="220" ry="80" transform="rotate(100 300 300)" />
      <ellipse cx="300" cy="300" rx="220" ry="80" transform="rotate(140 300 300)" />
    </g>
  </svg>

  <svg class="orb-layer orb-gem" viewBox="0 0 600 600">
    <g transform="translate(300 300)">
      <path d="M0 -60 L48 0 L0 80 L-48 0 Z" fill="var(--accent)" opacity="0.85" />
      <path d="M0 -60 L48 0 L-48 0 Z" fill="var(--accent-2)" opacity="0.55" />
      <path d="M0 -60 L0 80 M-48 0 L48 0" stroke="var(--bg)" stroke-width="1" opacity="0.4" />
    </g>
  </svg>

  <svg class="orb-layer orb-nodes" viewBox="0 0 600 600">
    <g fill="var(--accent-2)">
      <circle cx="120" cy="220" r="3" />
      <circle cx="480" cy="180" r="2.5" />
      <circle cx="500" cy="380" r="3.5" />
      <circle cx="100" cy="400" r="2.5" />
      <circle cx="380" cy="120" r="2" />
    </g>
  </svg>
</div>

<style>
  .orb-layer { position: absolute; inset: 0; width: 100%; height: 100%; }
  .orb-wire  { animation: orb-rotate 36s linear infinite; will-change: transform; }
  .orb-rings { animation: orb-rotate-rev 60s linear infinite; will-change: transform; }
  .orb-gem   { animation: orb-pulse 6s var(--ease) infinite; will-change: transform; }
  .orb-nodes { animation: node-blink 4s ease-in-out infinite; will-change: opacity; }
  .hero-orb.is-paused .orb-layer { animation-play-state: paused; }

  @keyframes orb-rotate { to { transform: rotate(360deg); } }
  @keyframes orb-rotate-rev { to { transform: rotate(-360deg); } }
  @keyframes orb-pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.05); } }
  @keyframes node-blink { 0%, 100% { opacity: 0.35; } 50% { opacity: 1; } }

  @media (prefers-reduced-motion: reduce) {
    .orb-layer { animation: none !important; }
  }
</style>

<script is:inline>
  (function () {
    const orb = document.querySelector('[data-hero-orb]');
    if (!orb || !('IntersectionObserver' in window)) return;
    new IntersectionObserver(function (entries) {
      orb.classList.toggle('is-paused', !entries[0].isIntersecting);
    }).observe(orb);
  })();
</script>
