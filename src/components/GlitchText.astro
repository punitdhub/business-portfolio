---
/**
 * GlitchText — retired. Now renders plain text so existing pages keep working.
 * The `accent` className is preserved for color emphasis.
 */
export interface Props {
  text: string;
  as?: 'span' | 'h1' | 'h2' | 'h3' | 'h4';
  auto?: boolean;
  className?: string;
}
const { text, as = 'span', className } = Astro.props;
const Tag = as;
---
<Tag class:list={[className]}>{text}</Tag>
