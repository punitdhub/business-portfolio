---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import ScheduleButton from './ScheduleButton.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(/\/$/, '');

const links = [
  { href: `${base}/about`, label: 'About' },
  { href: `${base}/employers`, label: 'Employers' },
  { href: `${base}/candidates`, label: 'Candidates' },
  { href: `${base}/contact`, label: 'Contact' },
];
---
<header class="site-header">
  <div class="container site-header-inner">
    <Logo height={30} />
    <nav class="nav-links" aria-label="Primary">
      {links.map((l) => (
        <a class="nav-link" href={l.href} aria-current={path === l.href || path.replace(base, '') === l.href.replace(base, '') ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
    <div class="header-actions">
      <ThemeToggle />
      <ScheduleButton label="Book Discovery" />
    </div>
  </div>
</header>

<script is:inline>
  // Liquid-neon hover tracking for buttons (light-touch, throttled).
  let lastRaf = 0;
  document.addEventListener('mousemove', (e) => {
    if (!e.target.closest) return;
    const btn = e.target.closest('.btn');
    if (!btn) return;
    if (performance.now() - lastRaf < 16) return;
    lastRaf = performance.now();
    const r = btn.getBoundingClientRect();
    btn.style.setProperty('--mx', `${e.clientX - r.left}px`);
    btn.style.setProperty('--my', `${e.clientY - r.top}px`);
  });
</script>
