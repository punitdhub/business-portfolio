---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import ScheduleButton from './ScheduleButton.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(/\/$/, '');

const links = [
  { href: `${base}/about`, label: 'About' },
  { href: `${base}/employers`, label: 'Employers' },
  { href: `${base}/candidates`, label: 'Candidates' },
  { href: `${base}/contact`, label: 'Contact' },
];
---
<header class="site-header">
  <div class="container site-header-inner">
    <Logo height={30} />
    <nav class="nav-links" aria-label="Primary">
      {links.map((l) => (
        <a class="nav-link" href={l.href} aria-current={path === l.href || path.replace(base, '') === l.href.replace(base, '') ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
    <div class="header-actions">
      <ThemeToggle />
      <ScheduleButton label="Book Discovery" />
    </div>
  </div>
</header>

<script is:inline>
  /**
   * Two pointer-driven micro-interactions:
   *   1. Spotlight on .panel — radial light follows cursor across cards.
   *   2. Magnetic buttons — primary buttons gently lean toward the cursor.
   * Both throttled via rAF, gated on prefers-reduced-motion.
   */
  (function () {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) return;

    let rafQueued = false;
    let lastE = null;

    function onMove(e) {
      lastE = e;
      if (rafQueued) return;
      rafQueued = true;
      requestAnimationFrame(flush);
    }

    function flush() {
      rafQueued = false;
      const e = lastE;
      if (!e) return;

      // Spotlight on panels in viewport
      const panels = document.querySelectorAll('.panel, .mandate, .timeline-step');
      for (const p of panels) {
        const r = p.getBoundingClientRect();
        if (r.bottom < 0 || r.top > window.innerHeight) continue;
        const px = e.clientX - r.left;
        const py = e.clientY - r.top;
        p.style.setProperty('--px', px + 'px');
        p.style.setProperty('--py', py + 'px');
      }

      // Magnetic effect on primary buttons within hover radius
      const buttons = document.querySelectorAll('.btn-primary, .btn-warm');
      for (const b of buttons) {
        const r = b.getBoundingClientRect();
        const cx = r.left + r.width / 2;
        const cy = r.top + r.height / 2;
        const dx = e.clientX - cx;
        const dy = e.clientY - cy;
        const dist = Math.hypot(dx, dy);
        const radius = Math.max(r.width, r.height) * 1.4;
        if (dist < radius) {
          const f = (1 - dist / radius) * 0.25;
          b.style.setProperty('--mag-x', (dx * f) + 'px');
          b.style.setProperty('--mag-y', (dy * f) + 'px');
        } else {
          b.style.setProperty('--mag-x', '0px');
          b.style.setProperty('--mag-y', '0px');
        }
      }
    }

    document.addEventListener('pointermove', onMove, { passive: true });
    document.addEventListener('pointerleave', function () {
      document.querySelectorAll('.btn-primary, .btn-warm').forEach(function (b) {
        b.style.setProperty('--mag-x', '0px');
        b.style.setProperty('--mag-y', '0px');
      });
    });
  })();
</script>
