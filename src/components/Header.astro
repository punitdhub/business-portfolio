---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import ScheduleButton from './ScheduleButton.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(/\/$/, '');

const links = [
  { href: `${base}/about/`, label: 'About' },
  { href: `${base}/employers/`, label: 'Employers' },
  { href: `${base}/candidates/`, label: 'Candidates' },
  { href: `${base}/roles/`, label: 'Roles' },
  { href: `${base}/insights/`, label: 'Insights' },
  { href: `${base}/contact/`, label: 'Contact' },
];
// 'page' for the exact page; 'true' when inside that section (e.g. an article under Insights).
const current = (href: string) => (path === href ? 'page' : path.startsWith(`${href}/`) ? 'true' : undefined);
---
<header class="site-header">
  <div class="container site-header-inner">
    <Logo height={30} />
    <nav class="nav-links" aria-label="Primary">
      {links.map((l) => (
        <a class="nav-link" href={l.href} aria-current={current(l.href)}>{l.label}</a>
      ))}
    </nav>
    <div class="header-actions">
      <ThemeToggle />
      <ScheduleButton label="Book Discovery" className="header-cta" />
      <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <svg class="icon-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu (≤920px). Hidden until the menu button is pressed. -->
  <nav class="mobile-menu" id="mobile-menu" aria-label="Mobile" hidden>
    <div class="container">
      <ul>
        {links.map((l) => (
          <li><a class="mobile-link" href={l.href} aria-current={current(l.href)}>{l.label}</a></li>
        ))}
      </ul>
      <ScheduleButton label="Book Discovery" className="mobile-menu-cta" />
    </div>
  </nav>
</header>

<script is:inline>
  // Mobile menu: open/close, Escape to close, close on link tap or when
  // the viewport grows past the mobile breakpoint.
  (function () {
    const btn = document.querySelector('[data-menu-toggle]');
    const menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;
    const mq = window.matchMedia('(max-width: 920px)');

    function setOpen(open, restoreFocus) {
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      menu.hidden = !open;
      document.documentElement.classList.toggle('menu-open', open);
      if (open) {
        const first = menu.querySelector('a');
        if (first) first.focus();
      } else if (restoreFocus) {
        btn.focus();
      }
    }

    btn.addEventListener('click', function () {
      setOpen(btn.getAttribute('aria-expanded') !== 'true', false);
    });
    menu.addEventListener('click', function (e) {
      if (e.target.closest('a')) setOpen(false, false);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !menu.hidden) setOpen(false, true);
    });
    mq.addEventListener('change', function (e) {
      if (!e.matches) setOpen(false, false);
    });
    // Close when keyboard focus moves past the menu so it can't cover the
    // focused element (WCAG 2.4.11).
    menu.addEventListener('focusout', function (e) {
      const to = e.relatedTarget;
      if (to && !menu.contains(to) && to !== btn) setOpen(false, false);
    });
  })();
</script>

<script is:inline>
  /**
   * Two pointer-driven micro-interactions:
   *   1. Spotlight on .panel — radial light follows cursor across cards.
   *   2. Magnetic buttons — primary buttons gently lean toward the cursor.
   * Both throttled via rAF, gated on prefers-reduced-motion.
   */
  (function () {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) return;

    let rafQueued = false;
    let lastE = null;

    function onMove(e) {
      lastE = e;
      if (rafQueued) return;
      rafQueued = true;
      requestAnimationFrame(flush);
    }

    function flush() {
      rafQueued = false;
      const e = lastE;
      if (!e) return;

      // Spotlight: only the panel under the cursor needs updating.
      const p = e.target && e.target.closest ? e.target.closest('.panel, .mandate, .timeline-step') : null;
      if (p) {
        const r = p.getBoundingClientRect();
        p.style.setProperty('--px', (e.clientX - r.left) + 'px');
        p.style.setProperty('--py', (e.clientY - r.top) + 'px');
      }

      // Magnetic effect on primary buttons within hover radius
      const buttons = Array.from(document.querySelectorAll('.btn-primary, .btn-warm'));
      const rects = buttons.map(function (b) { return b.getBoundingClientRect(); });
      buttons.forEach(function (b, i) {
        const r = rects[i];
        const cx = r.left + r.width / 2;
        const cy = r.top + r.height / 2;
        const dx = e.clientX - cx;
        const dy = e.clientY - cy;
        const dist = Math.hypot(dx, dy);
        const radius = Math.max(r.width, r.height) * 1.4;
        if (dist < radius) {
          const f = (1 - dist / radius) * 0.25;
          b.style.setProperty('--mag-x', (dx * f) + 'px');
          b.style.setProperty('--mag-y', (dy * f) + 'px');
        } else {
          b.style.setProperty('--mag-x', '0px');
          b.style.setProperty('--mag-y', '0px');
        }
      });
    }

    document.addEventListener('pointermove', onMove, { passive: true });
    document.addEventListener('pointerleave', function () {
      document.querySelectorAll('.btn-primary, .btn-warm').forEach(function (b) {
        b.style.setProperty('--mag-x', '0px');
        b.style.setProperty('--mag-y', '0px');
      });
    });
  })();
</script>
