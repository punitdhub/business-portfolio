---
/**
 * ScheduleButton — single component for all scheduling providers.
 * Switch provider in src/config.ts; no other code changes needed.
 *
 * Supports: calendly | cal | savvycal | tidycal | mailto | form
 * - For URL-based providers (calendly/cal/savvycal/tidycal), opens in a popup
 *   if the provider's embed script is loaded, otherwise opens in a new tab.
 * - For 'form' (default), links to /contact.
 * - For 'mailto', opens the user's mail client.
 */
import { scheduling, site } from '../config';

export interface Props {
  label?: string;
  variant?: 'primary' | 'ghost';
  className?: string;
}
const { label, variant = 'primary', className } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const buttonText = label || scheduling.buttonLabel;

let href = `${base}/contact`;
let dataProvider = scheduling.provider;
if (scheduling.provider === 'mailto') {
  href = `mailto:${site.email}?subject=Discovery%20call%20—%20Fortium%20Group`;
} else if (scheduling.url && scheduling.provider !== 'form') {
  href = scheduling.url;
}
---
<a
  href={href}
  class:list={['btn', variant === 'primary' ? 'btn-primary' : 'btn-ghost', className]}
  data-schedule
  data-provider={dataProvider}
  data-url={scheduling.url}
  target={(scheduling.provider !== 'form' && scheduling.provider !== 'mailto') ? '_blank' : undefined}
  rel={(scheduling.provider !== 'form' && scheduling.provider !== 'mailto') ? 'noopener noreferrer' : undefined}
>
  {buttonText} <span class="btn-arrow">→</span>
</a>

<script is:inline>
  (function () {
    document.addEventListener('click', (e) => {
      const a = e.target && e.target.closest && e.target.closest('[data-schedule]');
      if (!a) return;
      const provider = a.dataset.provider;
      const url = a.dataset.url;

      // Calendly popup if its script is loaded
      if (provider === 'calendly' && url && window.Calendly && typeof window.Calendly.initPopupWidget === 'function') {
        e.preventDefault();
        window.Calendly.initPopupWidget({ url });
        return;
      }
      // Cal.com inline trigger if its embed namespace is present
      if (provider === 'cal' && url && window.Cal) {
        e.preventDefault();
        try { window.Cal('ui', { theme: document.documentElement.dataset.theme === 'light' ? 'light' : 'dark' }); } catch (_) {}
        window.Cal('open', { calLink: url.replace(/^https?:\/\/cal\.com\//, '') });
        return;
      }
      // Default: let the anchor behave normally (popup tab or in-app link)
    });
  })();
</script>
