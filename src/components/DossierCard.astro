---
/**
 * DossierCard — signature hero visual.
 *
 * A mock candidate dossier card. Communicates the firm's deliverable
 * (vetted candidate briefs) at a glance, without stock illustrations
 * or emoji. All numbers are plausible placeholders.
 */
---
<div class="dossier" role="img" aria-label="Example candidate dossier preview">
  <div class="dossier-head">
    <span class="d-title">DOSSIER · MPC-0421</span>
    <span class="d-status">vetted</span>
  </div>
  <div class="dossier-candidate">
    <div class="dossier-avatar">AK</div>
    <div>
      <p class="dossier-name">A. Khatri</p>
      <p class="dossier-role">AI Red Team Lead · Series C</p>
    </div>
  </div>
  <div class="dossier-scores">
    <div class="d-score">
      <span class="d-k">DEPTH</span>
      <span class="d-v">9.4<span style="color:var(--text-dim); font-size:0.6em; margin-left:1px">/10</span></span>
      <div class="d-bar"><span style="width:94%"></span></div>
    </div>
    <div class="d-score">
      <span class="d-k">LEADERSHIP</span>
      <span class="d-v">8.7<span style="color:var(--text-dim); font-size:0.6em; margin-left:1px">/10</span></span>
      <div class="d-bar"><span style="width:87%"></span></div>
    </div>
    <div class="d-score">
      <span class="d-k">FIT</span>
      <span class="d-v">9.1<span style="color:var(--text-dim); font-size:0.6em; margin-left:1px">/10</span></span>
      <div class="d-bar"><span style="width:91%"></span></div>
    </div>
  </div>
  <div class="dossier-notes">
    <div class="d-note">Shipped jailbreak defence framework at a Fortune-50 lab</div>
    <div class="d-note">Validated by two active CISOs in our network</div>
    <div class="d-note">Compensation calibrated · ready to interview</div>
  </div>
  <div class="dossier-footer">
    <span class="d-match">Match confidence<strong>96%</strong></span>
    <span class="d-action">Review brief</span>
  </div>
</div>
