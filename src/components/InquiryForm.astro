---
// Static form, Formspree-ready.
// Replace FORMSPREE_ID with a real ID from formspree.io to enable email delivery.
export interface Props {
  audience?: 'client' | 'candidate' | 'general';
  compact?: boolean;
}
const { audience = 'general', compact = false } = Astro.props;
const FORMSPREE_ID = 'PLACEHOLDER_FORMSPREE_ID';
const action = `https://formspree.io/f/${FORMSPREE_ID}`;
---
<form class="form" action={action} method="POST" data-inquiry-form>
  <input type="hidden" name="_subject" value={`New Fortium inquiry — ${audience}`} />
  <input type="hidden" name="audience" value={audience} />
  <div class="honeypot" aria-hidden="true">
    <label>Leave this empty<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
  </div>

  <div class="form-row">
    <div>
      <label for="if-name">Name</label>
      <input id="if-name" name="name" type="text" required autocomplete="name" />
    </div>
    <div>
      <label for="if-email">Work email</label>
      <input id="if-email" name="email" type="email" required autocomplete="email" />
    </div>
  </div>

  {audience === 'client' && (
    <div class="form-row">
      <div>
        <label for="if-role">Role to fill</label>
        <input id="if-role" name="role" type="text" placeholder="e.g. Principal AI Red Teamer" />
      </div>
      <div>
        <label for="if-urgency">Urgency</label>
        <select id="if-urgency" name="urgency">
          <option>Immediate (within 30 days)</option>
          <option>Soon (1–2 quarters)</option>
          <option>Strategic (exploring)</option>
        </select>
      </div>
    </div>
  )}

  {audience === 'candidate' && (
    <div class="form-row">
      <div>
        <label for="if-current">Current title</label>
        <input id="if-current" name="current_title" type="text" placeholder="e.g. Senior Detection Engineer" />
      </div>
      <div>
        <label for="if-link">LinkedIn / portfolio</label>
        <input id="if-link" name="link" type="url" placeholder="https://" />
      </div>
    </div>
  )}

  {audience === 'general' && (
    <div>
      <label for="if-who">I am a</label>
      <select id="if-who" name="who">
        <option>Hiring manager / employer</option>
        <option>Security candidate</option>
        <option>Partner / vendor</option>
        <option>Press / other</option>
      </select>
    </div>
  )}

  {!compact && (
    <div>
      <label for="if-msg">Message</label>
      <textarea id="if-msg" name="message" placeholder="Tell us about the role, the team, or your situation." required></textarea>
    </div>
  )}

  <button class="btn btn-primary" type="submit">
    {audience === 'candidate' ? 'Submit confidentially' : 'Send inquiry'}
    <span class="btn-arrow">→</span>
  </button>

  <p class="muted text-mono" style="font-size:0.75rem; margin:0;">
    <span style="color: var(--accent-2)">●</span> Encrypted in transit · Initial reply within 1 business day
  </p>
</form>

<script is:inline>
  // Graceful fallback: if Formspree ID is still the placeholder, intercept submit
  // and show a friendly "demo" message instead of posting.
  document.addEventListener('submit', (e) => {
    const form = e.target.closest && e.target.closest('[data-inquiry-form]');
    if (!form) return;
    if (form.action.includes('PLACEHOLDER_FORMSPREE_ID')) {
      e.preventDefault();
      const panel = document.createElement('div');
      panel.className = 'card';
      panel.style.borderColor = 'var(--accent-2)';
      panel.innerHTML = '<h3 style="margin-top:0">✓ Captured locally</h3><p>This form is in demo mode. Connect a Formspree ID in <code>InquiryForm.astro</code> to deliver submissions to your inbox.</p>';
      form.replaceWith(panel);
    }
  });
</script>
