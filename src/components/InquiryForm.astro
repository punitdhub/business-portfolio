---
import { forms } from '../config';

export interface Props {
  audience?: 'client' | 'candidate' | 'general';
  compact?: boolean;
}
const { audience = 'general', compact = false } = Astro.props;
const isDemo = forms.provider === 'demo';
const action = `https://formspree.io/f/${forms.id}`;
const subject =
  audience === 'client' ? 'New employer inquiry'
  : audience === 'candidate' ? 'New candidate inquiry'
  : 'New Fortium inquiry';
---
<form
  class="form"
  action={action}
  method="POST"
  data-inquiry-form
  data-audience={audience}
  data-demo={isDemo ? 'true' : 'false'}
  novalidate
>
  <input type="hidden" name="_subject" value={`${subject} — Fortium Group`} />
  <input type="hidden" name="audience" value={audience} />
  <input type="hidden" name="source" value="fortium-website" />
  <!-- Honeypot — bots fill this, real users don't see it -->
  <div class="honeypot" aria-hidden="true">
    <label>Leave this empty<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
  </div>

  <div class="form-row">
    <div class="field">
      <input id={`if-name-${audience}`} name="name" type="text" required autocomplete="name" placeholder=" " />
      <label for={`if-name-${audience}`}>Your name</label>
    </div>
    <div class="field">
      <input id={`if-email-${audience}`} name="email" type="email" required autocomplete="email" placeholder=" " />
      <label for={`if-email-${audience}`}>Work email</label>
    </div>
  </div>

  {audience === 'client' && (
    <div class="form-row">
      <div class="field">
        <input id={`if-role-${audience}`} name="role" type="text" placeholder=" " />
        <label for={`if-role-${audience}`}>Role to fill</label>
      </div>
      <div class="field">
        <select id={`if-urgency-${audience}`} name="urgency" required>
          <option value="" disabled selected hidden></option>
          <option>Immediate — within 30 days</option>
          <option>Soon — 1–2 quarters</option>
          <option>Strategic — exploring</option>
        </select>
        <label for={`if-urgency-${audience}`}>Urgency</label>
        <svg class="field-select-arrow" aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9 L12 15 L18 9" /></svg>
      </div>
    </div>
  )}

  {audience === 'candidate' && (
    <div class="form-row">
      <div class="field">
        <input id={`if-current-${audience}`} name="current_title" type="text" placeholder=" " />
        <label for={`if-current-${audience}`}>Current title</label>
      </div>
      <div class="field">
        <input id={`if-link-${audience}`} name="link" type="url" placeholder=" " />
        <label for={`if-link-${audience}`}>LinkedIn / portfolio</label>
      </div>
    </div>
  )}

  {audience === 'general' && (
    <div class="field">
      <select id={`if-who-${audience}`} name="who" required>
        <option value="" disabled selected hidden></option>
        <option>Hiring manager or employer</option>
        <option>Security candidate</option>
        <option>Partner or vendor</option>
        <option>Press or other</option>
      </select>
      <label for={`if-who-${audience}`}>I am a…</label>
      <svg class="field-select-arrow" aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9 L12 15 L18 9" /></svg>
    </div>
  )}

  {!compact && (
    <div class="field">
      <textarea id={`if-msg-${audience}`} name="message" required placeholder=" "></textarea>
      <label for={`if-msg-${audience}`}>
        {audience === 'candidate'
          ? 'What kind of role are you looking for?'
          : audience === 'client'
            ? 'Tell us about the role, the team, and the threat surface'
            : 'How can we help?'}
      </label>
    </div>
  )}

  <div class="form-footer">
    <p class="form-hint">
      {isDemo
        ? 'Demo mode — set forms.provider = formspree in src/config.ts to deliver.'
        : 'Encrypted in transit · reply within 1 business day'}
    </p>
    <button class="btn btn-primary form-submit" type="submit">
      <span class="btn-text">
        {audience === 'candidate' ? 'Submit confidentially' : 'Send inquiry'}
        <span class="btn-arrow">→</span>
      </span>
    </button>
  </div>

  <p class="form-error" hidden></p>
</form>

<script is:inline>
  /**
   * Formspree AJAX submission with progressive enhancement.
   * No external dependency — uses fetch + Accept: application/json,
   * which Formspree supports natively.
   *
   * Falls back to standard form POST if JS fails (the action attribute is
   * already set, so the browser handles it).
   */
  (function () {
    document.addEventListener('submit', async function (e) {
      const form = e.target;
      if (!form || !form.matches || !form.matches('[data-inquiry-form]')) return;
      e.preventDefault();

      const errorEl = form.querySelector('.form-error');
      const submitBtn = form.querySelector('.form-submit');
      if (errorEl) { errorEl.hidden = true; errorEl.textContent = ''; }

      // Client-side validation
      const required = form.querySelectorAll('[required]');
      let invalid = null;
      for (const f of required) {
        if (!f.value || (f.type === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(f.value))) {
          invalid = f; break;
        }
      }
      if (invalid) {
        invalid.focus();
        invalid.setAttribute('aria-invalid', 'true');
        if (errorEl) {
          errorEl.textContent = invalid.type === 'email'
            ? 'Please enter a valid email address.'
            : 'Please fill in all required fields.';
          errorEl.hidden = false;
        }
        return;
      }

      // Demo mode short-circuit
      if (form.dataset.demo === 'true') {
        renderSuccess(form, true);
        return;
      }

      if (submitBtn) submitBtn.dataset.state = 'loading';

      try {
        const data = new FormData(form);
        const res = await fetch(form.action, {
          method: 'POST',
          body: data,
          headers: { Accept: 'application/json' },
        });
        if (res.ok) {
          renderSuccess(form, false);
        } else {
          const json = await res.json().catch(() => null);
          const msg = json && json.errors && json.errors.length
            ? json.errors.map(function (x) { return x.message; }).join('. ')
            : 'Something went wrong. Please email us directly.';
          if (errorEl) { errorEl.textContent = msg; errorEl.hidden = false; }
          if (submitBtn) submitBtn.dataset.state = '';
        }
      } catch (err) {
        if (errorEl) {
          errorEl.textContent = 'Network error. Please try again or email us directly.';
          errorEl.hidden = false;
        }
        if (submitBtn) submitBtn.dataset.state = '';
      }
    });

    function renderSuccess(form, isDemo) {
      const audience = form.dataset.audience || 'general';
      const wrap = document.createElement('div');
      wrap.className = 'form-success';
      const title = audience === 'candidate'
        ? 'Received. Welcome to the vetting queue.'
        : isDemo
          ? 'Captured locally — demo mode'
          : 'Transmission received.';
      const body = isDemo
        ? 'Wire up Formspree in src/config.ts to deliver inquiries to your inbox.'
        : audience === 'candidate'
          ? 'A Fortium recruiter will reach out within 1 business day. All communications stay confidential.'
          : 'You\'ll hear back from Punit within 1 business day with a calibration slot.';
      wrap.innerHTML =
        '<div class="check" aria-hidden="true">' +
          '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12 L10 17 L19 7"/></svg>' +
        '</div>' +
        '<h3>' + title + '</h3>' +
        '<p>' + body + '</p>';
      form.replaceWith(wrap);
    }

    // Strip aria-invalid as user types
    document.addEventListener('input', function (e) {
      const t = e.target;
      if (t && t.matches && t.matches('[aria-invalid]')) t.removeAttribute('aria-invalid');
    });
  })();
</script>
