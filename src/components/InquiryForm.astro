---
import { forms } from '../config';

export interface Props {
  audience?: 'client' | 'candidate' | 'general' | 'benchmark';
  compact?: boolean;
  /** Pre-fills the "Role" field (client and benchmark forms). */
  defaultRole?: string;
}
const { audience = 'general', compact = false, defaultRole = '' } = Astro.props;
const isDemo = forms.provider === 'demo';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const action = `https://formspree.io/f/${forms.id}`;
const subject =
  audience === 'client' ? 'New employer inquiry'
  : audience === 'candidate' ? 'New candidate inquiry'
  : audience === 'benchmark' ? 'Salary benchmark request'
  : 'New Fortium inquiry';
---
<form
  class="form"
  action={action}
  method="POST"
  data-inquiry-form
  data-audience={audience}
  data-demo={isDemo ? 'true' : 'false'}
>
  <input type="hidden" name="_subject" value={`${subject} — Fortium Group`} />
  <input type="hidden" name="audience" value={audience} />
  <input type="hidden" name="source" value="fortium-website" />
  <!-- Honeypot — bots fill this, real users don't see it -->
  <div class="honeypot" aria-hidden="true">
    <label>Leave this empty<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
  </div>

  <div class="form-row">
    <div class="field">
      <input id={`if-name-${audience}`} name="name" type="text" required autocomplete="name" placeholder=" " />
      <label for={`if-name-${audience}`}>Your name</label>
    </div>
    <div class="field">
      <input id={`if-email-${audience}`} name="email" type="email" required autocomplete="email" placeholder=" " />
      <label for={`if-email-${audience}`}>Work email</label>
    </div>
  </div>

  {audience === 'client' && (
    <div class="form-row">
      <div class="field">
        <input id={`if-role-${audience}`} name="role" type="text" placeholder=" " value={defaultRole} />
        <label for={`if-role-${audience}`}>Role to fill</label>
      </div>
      <div class="field">
        <select id={`if-urgency-${audience}`} name="urgency" required>
          <option value="" disabled selected hidden></option>
          <option>Immediate — within 30 days</option>
          <option>Soon — 1–2 quarters</option>
          <option>Strategic — exploring</option>
        </select>
        <label for={`if-urgency-${audience}`}>Urgency</label>
        <svg class="field-select-arrow" aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9 L12 15 L18 9" /></svg>
      </div>
    </div>
  )}

  {audience === 'candidate' && (
    <div class="form-row">
      <div class="field">
        <input id={`if-current-${audience}`} name="current_title" type="text" placeholder=" " />
        <label for={`if-current-${audience}`}>Current title</label>
      </div>
      <div class="field">
        <input id={`if-link-${audience}`} name="link" type="url" placeholder=" " />
        <label for={`if-link-${audience}`}>LinkedIn / portfolio</label>
      </div>
    </div>
  )}

  {audience === 'benchmark' && (
    <>
      <div class="form-row">
        <div class="field">
          <input id={`if-role-${audience}`} name="role" type="text" required placeholder=" " value={defaultRole} />
          <label for={`if-role-${audience}`}>Role to benchmark</label>
        </div>
        <div class="field">
          <input id={`if-location-${audience}`} name="location" type="text" required placeholder=" " />
          <label for={`if-location-${audience}`}>Location / region</label>
        </div>
      </div>
      <div class="field">
        <select id={`if-seniority-${audience}`} name="seniority" required>
          <option value="" disabled selected hidden></option>
          <option>Individual contributor — mid-level</option>
          <option>Individual contributor — senior / staff</option>
          <option>Manager / lead</option>
          <option>Director / VP</option>
          <option>Executive (CISO)</option>
        </select>
        <label for={`if-seniority-${audience}`}>Seniority</label>
        <svg class="field-select-arrow" aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9 L12 15 L18 9" /></svg>
      </div>
    </>
  )}

  {audience === 'general' && (
    <div class="field">
      <select id={`if-who-${audience}`} name="who" required>
        <option value="" disabled selected hidden></option>
        <option>Hiring manager or employer</option>
        <option>Security candidate</option>
        <option>Partner or vendor</option>
        <option>Press or other</option>
      </select>
      <label for={`if-who-${audience}`}>I am a…</label>
      <svg class="field-select-arrow" aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9 L12 15 L18 9" /></svg>
    </div>
  )}

  {!compact && (
    <div class="field">
      <textarea id={`if-msg-${audience}`} name="message" required={audience !== 'benchmark'} placeholder=" "></textarea>
      <label for={`if-msg-${audience}`}>
        {audience === 'candidate'
          ? 'What kind of role are you looking for?'
          : audience === 'client'
            ? 'Tell us about the role, the team, and the threat surface'
          : audience === 'benchmark'
            ? 'Anything else we should know? (optional)'
            : 'How can we help?'}
      </label>
    </div>
  )}

  <div class="form-footer">
    <p class="form-hint">
      {isDemo
        ? 'Demo mode — set forms.provider = formspree in src/config.ts to deliver.'
        : 'Encrypted in transit · reply within 1 business day'}
    </p>
    <button class="btn btn-primary form-submit" type="submit">
      <span class="btn-text">
        {audience === 'candidate' ? 'Submit confidentially' : audience === 'benchmark' ? 'Request benchmark' : 'Send inquiry'}
        <span class="btn-arrow">→</span>
      </span>
    </button>
  </div>

  <p class="form-consent">
    By submitting, you agree to our <a href={`${base}/privacy/`}>Privacy Policy</a>. We never share your details without your consent.
  </p>
  <p class="form-error" id={`if-error-${audience}`} role="alert" hidden></p>
</form>

<script is:inline>
  /**
   * Formspree AJAX submission with progressive enhancement.
   * Without JS the form posts natively (and native validation applies, because
   * `novalidate` is only switched on here, when this script runs).
   */
  (function () {
    if (window.__fgInquiry) return; // emitted per form instance; bind once
    window.__fgInquiry = true;

    document.querySelectorAll('[data-inquiry-form]').forEach(function (f) { f.noValidate = true; });

    function showError(form, msg, field) {
      const errorEl = form.querySelector('.form-error');
      if (!errorEl) return;
      errorEl.textContent = msg;
      errorEl.hidden = false;
      if (field) field.setAttribute('aria-describedby', errorEl.id);
    }

    function firstInvalid(form) {
      const fields = form.querySelectorAll('input:not([type=hidden]):not([name=_gotcha]), select, textarea');
      for (const f of fields) {
        const v = (f.value || '').trim();
        if (f.required && !v) return { field: f, msg: 'Please fill in all required fields.' };
        if (v && f.type === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)) return { field: f, msg: 'Please enter a valid email address.' };
        if (v && f.type === 'url' && !f.checkValidity()) return { field: f, msg: 'Please enter a full URL, starting with https://' };
      }
      return null;
    }

    document.addEventListener('submit', async function (e) {
      const form = e.target;
      if (!form || !form.matches || !form.matches('[data-inquiry-form]')) return;
      e.preventDefault();
      if (form.dataset.submitting === 'true') return; // block double submits

      const errorEl = form.querySelector('.form-error');
      const submitBtn = form.querySelector('.form-submit');
      if (errorEl) { errorEl.hidden = true; errorEl.textContent = ''; }

      const invalid = firstInvalid(form);
      if (invalid) {
        invalid.field.setAttribute('aria-invalid', 'true');
        showError(form, invalid.msg, invalid.field);
        invalid.field.focus();
        return;
      }

      if (form.dataset.demo === 'true') { renderSuccess(form, true); return; }

      form.dataset.submitting = 'true';
      if (submitBtn) { submitBtn.dataset.state = 'loading'; submitBtn.disabled = true; }
      const reset = function () {
        form.dataset.submitting = '';
        if (submitBtn) { submitBtn.dataset.state = ''; submitBtn.disabled = false; }
      };

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (res.ok) {
          renderSuccess(form, false);
        } else {
          const json = await res.json().catch(() => null);
          const msgs = json && Array.isArray(json.errors)
            ? json.errors.map(function (x) { return x && x.message; }).filter(Boolean)
            : [];
          showError(form, msgs.length ? msgs.join('. ') : 'Something went wrong. Please email us directly.');
          reset();
        }
      } catch (err) {
        showError(form, 'Network error. Please try again or email us directly.');
        reset();
      }
    });

    // Static strings only — never interpolate user or server data here.
    function renderSuccess(form, isDemo) {
      const audience = form.dataset.audience || 'general';
      const wrap = document.createElement('div');
      wrap.className = 'form-success';
      wrap.setAttribute('role', 'status');
      wrap.tabIndex = -1;
      const title = isDemo
        ? 'Captured locally — demo mode'
        : audience === 'candidate'
          ? 'Received — thank you.'
          : audience === 'benchmark'
            ? 'Benchmark request received.'
            : 'Message received.';
      const body = isDemo
        ? 'Wire up Formspree in src/config.ts to deliver inquiries to your inbox.'
        : audience === 'candidate'
          ? 'Punit will reach out within 1 business day. Everything you share stays confidential.'
          : audience === 'benchmark'
            ? 'Your compensation snapshot will arrive by email, typically within 2 business days.'
            : 'You\'ll hear back from Punit within 1 business day.';
      wrap.innerHTML =
        '<div class="check" aria-hidden="true">' +
          '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12 L10 17 L19 7"/></svg>' +
        '</div>' +
        '<h3>' + title + '</h3>' +
        '<p>' + body + '</p>';
      form.replaceWith(wrap);
      wrap.focus();
    }

    // Clear error state as the user corrects a field
    document.addEventListener('input', function (e) {
      const t = e.target;
      if (t && t.getAttribute && t.getAttribute('aria-invalid') === 'true') {
        t.removeAttribute('aria-invalid');
        t.removeAttribute('aria-describedby');
      }
    });
  })();
</script>
