---
import { forms } from '../config';

export interface Props {
  audience?: 'client' | 'candidate' | 'general';
  compact?: boolean;
}
const { audience = 'general', compact = false } = Astro.props;
const isDemo = forms.provider === 'demo' || forms.id === 'PLACEHOLDER_FORMSPREE_ID';
const action = `https://formspree.io/f/${forms.id}`;
---
<form class="form" action={isDemo ? '#' : action} method="POST" data-inquiry-form data-demo={isDemo ? 'true' : 'false'}>
  <input type="hidden" name="_subject" value={`New Fortium inquiry — ${audience}`} />
  <input type="hidden" name="audience" value={audience} />
  <div class="honeypot" aria-hidden="true">
    <label>Leave this empty<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
  </div>

  <div class="form-row">
    <div>
      <label for={`if-name-${audience}`}>Name</label>
      <input id={`if-name-${audience}`} name="name" type="text" required autocomplete="name" />
    </div>
    <div>
      <label for={`if-email-${audience}`}>Work email</label>
      <input id={`if-email-${audience}`} name="email" type="email" required autocomplete="email" />
    </div>
  </div>

  {audience === 'client' && (
    <div class="form-row">
      <div>
        <label for={`if-role-${audience}`}>Role to fill</label>
        <input id={`if-role-${audience}`} name="role" type="text" placeholder="e.g. Principal AI Red Teamer" />
      </div>
      <div>
        <label for={`if-urgency-${audience}`}>Urgency</label>
        <select id={`if-urgency-${audience}`} name="urgency">
          <option>Immediate (within 30 days)</option>
          <option>Soon (1–2 quarters)</option>
          <option>Strategic (exploring)</option>
        </select>
      </div>
    </div>
  )}

  {audience === 'candidate' && (
    <div class="form-row">
      <div>
        <label for={`if-current-${audience}`}>Current title</label>
        <input id={`if-current-${audience}`} name="current_title" type="text" placeholder="e.g. Senior Detection Engineer" />
      </div>
      <div>
        <label for={`if-link-${audience}`}>LinkedIn / portfolio</label>
        <input id={`if-link-${audience}`} name="link" type="url" placeholder="https://" />
      </div>
    </div>
  )}

  {audience === 'general' && (
    <div>
      <label for={`if-who-${audience}`}>I am a</label>
      <select id={`if-who-${audience}`} name="who">
        <option>Hiring manager / employer</option>
        <option>Security candidate</option>
        <option>Partner / vendor</option>
        <option>Press / other</option>
      </select>
    </div>
  )}

  {!compact && (
    <div>
      <label for={`if-msg-${audience}`}>Message</label>
      <textarea id={`if-msg-${audience}`} name="message" placeholder="Tell us about the role, the team, or your situation." required></textarea>
    </div>
  )}

  <button class="btn btn-primary" type="submit">
    {audience === 'candidate' ? 'Submit confidentially' : 'Send inquiry'}
    <span class="btn-arrow">→</span>
  </button>

  <p class="dim text-mono" style="font-size:0.7rem; margin:0; letter-spacing:0.1em">
    <span style="color: var(--accent-2)">●</span> ENCRYPTED IN TRANSIT · INITIAL REPLY WITHIN 1 BUSINESS DAY
  </p>
</form>

<script is:inline>
  // Demo-mode interception: when no Formspree ID is configured, render a friendly
  // capture panel instead of POSTing to a placeholder URL.
  document.addEventListener('submit', (e) => {
    const form = e.target.closest && e.target.closest('[data-inquiry-form]');
    if (!form) return;
    if (form.dataset.demo === 'true') {
      e.preventDefault();
      const panel = document.createElement('div');
      panel.className = 'panel';
      panel.style.borderColor = 'var(--accent-2)';
      panel.innerHTML =
        '<h3 style="margin-top:0; color:var(--accent-2)">[ CAPTURED LOCALLY ]</h3>' +
        '<p>This form is in demo mode. To deliver inquiries to your inbox, set <code class="text-mono text-accent">forms.provider = \'formspree\'</code> and your <code class="text-mono text-accent">forms.id</code> in <code class="text-mono text-accent">src/config.ts</code>.</p>';
      form.replaceWith(panel);
    }
  });
</script>
